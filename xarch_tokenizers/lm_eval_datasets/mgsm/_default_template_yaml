
# https://github.com/EleutherAI/lm-evaluation-harness/blob/main/lm_eval/tasks/gsm8k/gsm8k.yaml

tag: 
  - multilingual
task: juletxara/mgsm
dataset_path: juletxara/mgsm
dataset_name: null
test_split: test
fewshot_split: train
fewshot_config: 
  sampler: first_n
output_type: generate_until  
# doc_to_text: "Question: {{question}}\n\nProvide a step-by-step solution. Your final answer should be in the format '#### [number]' where [number] is just the numeric answer."
# doc_to_text: "Question: {{question}}\n\nProvide a step-by-step solution. First outline your approach, then work through the calculations step by step. End your answer with a line in exactly this format: 'The answer is #### [number]'"
doc_to_text: "{{ question.strip() }}"
# doc_to_text: "Question: {{question}}\n\nSolve this step-by-step, and end with '#### [answer]'"
doc_to_target: "{{ answer_number }}"
generation_kwargs:
  temperature: 0.1
  do_sample: True
  # until:
  #   - "\n\n"
  #   - "\n"
  until:
    - "\n\nQuestion:"
    - "\n\nHuman:"
    - "\n\nUser:"
    - "</s>"
    - "<|im_end|>"
filter_list:
  - filter:
    - function: regex
      group_select: -1
      regex_pattern: (-?[$0-9.,]{2,})|(-?[0-9]+)
    - function: take_first
    name: flexible-extract
  - filter:
    - function: "regex"
      regex_pattern: "The answer is (\\-?[0-9\\.\\,]+)"
    - function: "take_first"
    name: "strict-match"
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
    ignore_case: true
    ignore_punctuation: true
repeats: 1
metadata:
  version: 0.0
  num_fewshot: 4
